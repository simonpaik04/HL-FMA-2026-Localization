<launch>
  <node pkg="mando_localization" type="odometry_gps_fusion_node"
        name="odometry_gps_fusion_reanchor_rostest" output="screen" required="true">
    <rosparam command="load"
              file="$(find mando_localization)/config/localization_interfaces.yaml"/>
    <rosparam command="load"
              file="$(find mando_localization)/config/gps_reference.yaml"/>
    <rosparam command="load"
              file="$(find mando_localization)/config/status_policy.yaml"/>
    <param name="timing/require_clock_ready" value="false"/>
  </node>

  <test test-name="gps_gate_reanchor_ack"
        pkg="mando_localization"
        type="test_gps_gate_reanchor.py"
        time-limit="15.0"/>
</launch>
