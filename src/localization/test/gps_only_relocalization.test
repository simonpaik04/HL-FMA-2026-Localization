<launch>
  <node pkg="mando_localization" type="localization_supervisor_node"
        name="localization_supervisor_gps_only_rostest" output="screen" required="true">
    <rosparam command="load"
              file="$(find mando_localization)/config/localization_interfaces.yaml"/>
    <rosparam command="load"
              file="$(find mando_localization)/config/status_policy.yaml"/>
    <rosparam command="load"
              file="$(find mando_localization)/config/relocalization_policy.yaml"/>
    <rosparam command="load"
              file="$(find mando_localization)/config/gps_reference.yaml"/>
    <param name="absolute_sources/gps_enabled" value="true"/>
    <param name="reference/measured" value="true"/>
    <param name="relocalization/long_outage_sec" value="0.5"/>
    <param name="relocalization/gps_only/automatic_reset_enabled" value="true"/>
    <param name="relocalization/gps_only/global_confirmation_timeout_sec" value="2.0"/>
  </node>

  <test test-name="gps_only_long_outage_recovery"
        pkg="mando_localization"
        type="test_gps_only_relocalization.py"
        time-limit="20.0"/>
</launch>
