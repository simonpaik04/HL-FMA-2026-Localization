<launch>
  <param name="/use_sim_time" value="true"/>
  <include file="$(find mando_localization)/launch/local_fusion.launch"/>
  <include file="$(find mando_localization)/launch/global_fusion.launch"/>
  <!-- 시험이 IMU 장착 TF를 늦게 발행하여 초기화 대기와 장착 yaw를 확인한다. -->
  <test test-name="initial_heading" pkg="mando_localization"
        type="test_initial_heading_ros.py" time-limit="60"/>
</launch>
