<launch>
  <param name="/use_sim_time" value="true"/>
  <include file="$(find mando_localization)/launch/bringup.launch">
    <!-- 원점에서 동쪽으로 시작하는 합성 궤적이며 용인 출발선이 아니다. -->
    <arg name="initialize_heading" value="false"/>
    <arg name="start_rddf_initialization" value="false"/>
    <arg name="start_encoder_driver" value="false"/>
    <arg name="start_imu_driver" value="false"/>
    <arg name="start_gps_driver" value="false"/>
    <arg name="start_rviz" value="false"/>
    <arg name="start_visualization" value="false"/>
  </include>
  <test test-name="delayed_gps_ekf" pkg="mando_localization"
        type="test_delayed_gps_ekf.py" time-limit="55"/>
</launch>
